{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Transpiler",
  "version": "0.1.0",
  "identifier": "com.transpiler.app",
  "build": {
    "beforeDevCommand": "npm run build",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Transpiler — AI Mathematical Animation Studio",
        "width": 1360,
        "height": 860,
        "minWidth": 1024,
        "minHeight": 700,
        "url": "http://127.0.0.1:8000"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": null,
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
